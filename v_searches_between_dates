# Here is the important additional piece of code to specify the dates in pubmed

def pubmed_count(search_term):

    # define publications from 1 Jan 2000 through 31 Dec 2020
    date_filter = (
        '"2000/01/01"[pdat] : "2020/12/31"[pdat]'
    )

    full_search = f'({search_term}) AND ({date_filter})'

    params = {
        "db": "pubmed",
        "term": full_search,
        "retmode": "json",
        "email": "YOUREMAIL@EMAIL.COM"
    }

    response = requests.post(
        url,
        data=params,
        timeout=30
    )

    response.raise_for_status()

    return int(
        response.json()["esearchresult"]["count"]
    )

