# Searches pubmed for papers containing the term "gene" in title/abstract too
# First MR papers, then total papers

import requests
import pandas as pd
import time

# Put each search term here
search_terms_gene_mr = {

    "Type 2": (
        '(("mendelian randomisation"[tiab] OR "mendelian randomization"[tiab]) '
        'AND ("type 2 diabetes"[tiab] OR "type-2 diabetes"[tiab] '
        'OR "T2D"[tiab] OR "type II diabetes"[tiab] OR "type-II diabetes"[tiab]) '
        'AND "gene"[tiab])'
    ),

    "Type 1": (
        '(("mendelian randomisation"[tiab] OR "mendelian randomization"[tiab]) '
        'AND ("type 1 diabetes"[tiab] OR "type-1 diabetes"[tiab] '
        'OR "T1D"[tiab] OR "type I diabetes"[tiab] OR "type-I diabetes"[tiab]) '
        'AND "gene"[tiab])'
    ),

    "Gestational": (
        '(("mendelian randomisation"[tiab] OR "mendelian randomization"[tiab]) '
        'AND ("gestational diabetes"[tiab]) '
        'AND "gene"[tiab])'
    ),

    "LADA": (
        '(("mendelian randomisation"[tiab] OR "mendelian randomization"[tiab]) '
        'AND ("LADA"[tiab] OR "latent autoimmune diabetes in adults"[tiab]) '
        'AND "gene"[tiab])'
    ),

    "MODY": (
        '(("mendelian randomisation"[tiab] OR "mendelian randomization"[tiab]) '
        'AND ("MODY"[tiab] OR "maturity onset diabetes of the young"[tiab] OR "maturity-onset diabetes of the young"[tiab]) '
        'AND "gene"[tiab])'
    ),

    "Neonatal": (
        '(("mendelian randomisation"[tiab] OR "mendelian randomization"[tiab]) '
        'AND ("neonatal diabetes"[tiab]) '
        'AND "gene"[tiab])'
    ),

    "CFRD": (
        '(("mendelian randomisation"[tiab] OR "mendelian randomization"[tiab]) '
        'AND ("cystic fibrosis-related diabetes"[tiab] '
        'OR "CFRD"[tiab] '
        'OR "cystic fibrosis related diabetes"[tiab]) '
        'AND "gene"[tiab])'
    ),

    "Type 3c": (
        '(("mendelian randomisation"[tiab] OR "mendelian randomization"[tiab]) '
        'AND ("type 3c diabetes"[tiab] '
        'OR "pancreatic diabetes"[tiab] '
        'OR "pancreatogenic diabetes"[tiab]) '
        'AND "gene"[tiab])'
    ),

    "Ketosis-prone": (
        '(("mendelian randomisation"[tiab] OR "mendelian randomization"[tiab]) '
        'AND ("ketosis-prone diabetes"[tiab] '
        'OR "ketosis prone diabetes"[tiab]) '
        'AND "gene"[tiab])'
    ),

    "Post-transplantation": (
        '(("mendelian randomisation"[tiab] OR "mendelian randomization"[tiab]) '
        'AND ("post-transplantation diabetes"[tiab] '
        'OR "post transplantation diabetes"[tiab] '
        'OR "post-transplant diabetes"[tiab] '
        'OR "post transplant diabetes"[tiab] '
        'OR "PTDM"[tiab] '
        'OR "new-onset diabetes after transplantation"[tiab] '
        'OR "new-onset diabetes after transplant"[tiab] '
        'OR "new onset diabetes after transplantation"[tiab] '
        'OR "new onset diabetes after transplant"[tiab] '
        'OR "NODAT"[tiab]) '
        'AND "gene"[tiab])'
    ),

    "Wolfram syndrome": (
        '(("mendelian randomisation"[tiab] OR "mendelian randomization"[tiab]) '
        'AND ("wolfram syndrome"[tiab]) '
        'AND "gene"[tiab])'
    ),

    "Alstrom syndrome": (
        '(("mendelian randomisation"[tiab] OR "mendelian randomization"[tiab]) '
        'AND ("alstrom syndrome"[tiab]) '
        'AND "gene"[tiab])'
    ),

    "Type 5": (
        '(("mendelian randomisation"[tiab] OR "mendelian randomization"[tiab]) '
        'AND ("type 5 diabetes"[tiab] '
        'OR "malnutrition-related diabetes"[tiab] '
        'OR "malnutrition related diabetes"[tiab] '
        'OR "MRDM"[tiab]) '
        'AND "gene"[tiab])'
    ),

    "Steroid-induced": (
        '(("mendelian randomisation"[tiab] OR "mendelian randomization"[tiab]) '
        'AND ("steroid-induced diabetes"[tiab] '
        'OR "steroid induced diabetes"[tiab]) '
        'AND "gene"[tiab])'
    )
}

url = "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi"

results = []

for name, search_term in search_terms_gene_mr.items():

    params = {
        "db": "pubmed",
        "term": search_term,
        "retmode": "json"
    }

    response = requests.get(url, params=params)
    response.raise_for_status()

    data = response.json()
    number_of_results = int(data["esearchresult"]["count"])

    results.append({
        "Diabetes type": name,
        "Number of genetic MR papers": number_of_results
    })

    time.sleep(0.4)

# Make the table
gene_mr_table = pd.DataFrame(results)

gene_mr_table

