# Search pubmed
url = "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi"

results = []

for name, search_term in search_terms_total.items():

    params = {
        "db": "pubmed",
        "term": search_term,
        "retmode": "json"
    }

    response = requests.get(url, params=params)
    response.raise_for_status()

    data = response.json()
    number_of_results = int(data["esearchresult"]["count"])

    results.append({
        "Diabetes type": name,
        "Number of total publications": number_of_results
    })

    time.sleep(0.4)

# Make the table
total_table = pd.DataFrame(results)

